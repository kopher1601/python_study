build/
dist/
*.egg-info/

# 테스트 / 린터 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 환경변수
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# 에디터 임시 파일
*.swp
*~
